# Variables del ENTORNO DE PRUEBAS. Copia este archivo a `.env.staging`.
#
# Nunca copies aquí credenciales de producción: el sentido de este entorno
# es poder equivocarse sin consecuencias. Si pegas el token real de Mercado
# Pago, un pedido de prueba cobra de verdad.
#
# `npm run staging` fuerza por su cuenta: APP_ENVIRONMENT=staging,
# SQLITE_PATH=.data/staging.db, MEDIA_DIRECTORY=uploads-staging y
# MERCADO_PAGO_TEST_MODE=true. No hace falta repetirlos.

# --- Identidad del entorno ---
STAGING_PORT=3300
# Si publicas staging detrás de un dominio, ponlo aquí (con https://).
# STAGING_URL=https://pruebas.tudominio.com

# Secreto de sesión propio del entorno de pruebas. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Si lo dejas vacío se genera uno al vuelo y las sesiones se cierran en cada reinicio.
STAGING_AUTH_SECRET=

# --- Propietario del panel en pruebas ---
ADMIN_OWNER_EMAIL=owner@shoppluscol.local
ADMIN_OWNER_NAME=Propietario (pruebas)
# Contraseña SOLO para el entorno de pruebas. Distinta de la de producción.
ADMIN_OWNER_PASSWORD=

# --- Mercado Pago (SOLO credenciales de prueba) ---
# Meta > "Tus integraciones" > tu aplicación > Credenciales de PRUEBA.
# El Access Token de prueba empieza por TEST-.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# --- Meta Pixel + Conversions API ---
# El código de eventos de prueba sale de Events Manager > Probar eventos.
# Sin él, los eventos cuentan como REALES y ensucian el aprendizaje de las
# campañas. `npm run staging` avisa si falta.
META_PIXEL_ID=
META_CONVERSIONS_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
META_GRAPH_API_VERSION=v21.0

# --- Correo ---
# Deja SMTP_HOST vacío para desactivar el envío por completo (opción
# recomendada si no tienes un buzón de pruebas). Con un servicio tipo
# Mailtrap/Ethereal los correos quedan retenidos y no llegan a nadie.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=pruebas@shoppluscol.local
