{
  "name": "shoppluscol-ecommerce",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep accesibilidad",
    "test:responsive": "playwright test --grep desborda",
    "test:lighthouse": "node scripts/run-lighthouse.mjs",
    "postinstall": "node scripts/apply-local-patches.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/db/migrate.ts",
    "db:seed": "tsx src/infrastructure/db/seed.ts",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "db:export": "node scripts/db-export.mjs",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "cf:build": "node scripts/run-cloudflare.mjs build",
    "cf:preview": "node scripts/run-cloudflare.mjs preview",
    "cf:preview:staging": "node scripts/run-cloudflare.mjs preview --env staging",
    "cf:deploy": "node scripts/run-cloudflare.mjs deploy",
    "cf:deploy:staging": "node scripts/run-cloudflare.mjs deploy --env staging"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@mediapipe/tasks-vision": "^1.0.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "nodemailer": "^9.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/workers-types": "^5.20260729.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^12.11.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "lighthouse": "^13.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
