{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shoppluscol-ecommerce",
  "main": ".open-next/worker.js",
  // Fecha de compatibilidad conocida y estable. Antes de desplegar a
  // producción, confirma si conviene actualizarla (ver docs/DEPLOYMENT.md).
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "shoppluscol-ecommerce"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      // Crea la base con `npx wrangler d1 create shoppluscol-db` y pega aquí
      // el database_id real antes de desplegar (ver docs/DEPLOYMENT.md).
      "database_name": "shoppluscol-db",
      "database_id": "REPLACE_WITH_REAL_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "shoppluscol-ecommerce-opennext-cache"
    },
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "shoppluscol-media"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "MAINTENANCE_MODE": "false",
    "CLOUDFLARE_WORKER": "1"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "shoppluscol-ecommerce-staging",
      "vars": {
        "MAINTENANCE_MODE": "true",
        "CLOUDFLARE_WORKER": "1"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "shoppluscol-ecommerce-staging"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "shoppluscol-db-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_DATABASE_ID",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "shoppluscol-ecommerce-staging-cache"
        },
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "shoppluscol-media-staging"
        }
      ],
      "images": {
        "binding": "IMAGES"
      }
    }
  }
}
