# Copia este archivo a .env.local para desarrollo. Nunca comitear valores reales.

# --- Aplicación ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development
APP_REVISION=local

# --- Base de datos (SQLite local; D1 se configura vía wrangler.toml en Cloudflare) ---
SQLITE_PATH=./.data/local.db
BACKUP_DIRECTORY=./.data/backups
EXPORT_DIRECTORY=./.data/exports

# --- Modo mantenimiento (sección 6) ---
MAINTENANCE_MODE=false

# --- Sesión / autenticación ---
# Genera un secreto de al menos 32 bytes para cualquier entorno compartido.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# El propietario se crea/actualiza con db:seed; nunca uses una clave pública fija.
ADMIN_OWNER_EMAIL=owner@shoppluscol.local
ADMIN_OWNER_NAME=Propietario ShopPlusCol
ADMIN_OWNER_PASSWORD=
# --- Marca y contacto (valores de ejemplo, editables desde el panel en la Fase 3) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=573000000000
NEXT_PUBLIC_SUPPORT_EMAIL=hola@shoppluscol.com

# --- Almacenamiento de medios (R2 en Cloudflare / disco local en desarrollo) ---
STORAGE_DRIVER=local
MEDIA_PUBLIC_URL=http://localhost:3000/uploads

# --- Mercado Pago (entorno de pruebas hasta que el propietario entregue credenciales reales) ---
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_TEST_MODE=true

# --- Meta Pixel + Conversions API (sección 21) ---
META_PIXEL_ID=
META_CONVERSIONS_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
META_GRAPH_API_VERSION=

# --- SMTP / notificaciones por correo (sección 38) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
